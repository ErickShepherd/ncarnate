    given-names: "Erick Edward"
    email: "dev@erickshepherd.com"
    orcid: "https://orcid.org/0000-0002-4750-6100"
version: "2.3.1"
# Add date-released on the actual publication date.
# This is the verified concept DOI, which identifies all versions.
doi: "10.5281/zenodo.21288802"
license: MIT
repository-code: "https://github.com/ErickShepherd/ncarnate"
url: "https://github.com/ErickShepherd/ncarnate"
keywords:
  - netCDF
  - HDF4
  - HDF-EOS2
  - compression
  - CF conventions
  - atmospheric science
  - remote sensing
